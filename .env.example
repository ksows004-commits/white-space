# 이 파일을 복사해서 .env.local로 저장하고 실제 값을 채우세요.
# cp .env.example .env.local
#
# .env.local은 .gitignore에 등록돼 있어 git에 올라가지 않습니다 — 실제 값을
# 여기(.env.example)에는 절대 채우지 마세요.

# Anthropic Claude API 키 — AI 리포트/채팅/트리아지/전체 회차 상담 기능에 필요.
# https://console.anthropic.com/ 에서 발급.
ANTHROPIC_API_KEY=

# Supabase 프로젝트 URL과 서비스 롤 키 — 검사 회차(배치) 데이터 저장소.
# Supabase 프로젝트 생성 후 Project Settings > API 에서 확인.
# 테이블 스키마는 supabase/schema.sql 참고.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 물리 판정 서버(FastAPI, api.py) 주소. 로컬에서 uvicorn api:app --port 8000으로
# 띄웠다면 기본값(http://localhost:8000)을 그대로 쓰면 되므로 생략 가능합니다.
# GPU_API_URL=http://localhost:8000
